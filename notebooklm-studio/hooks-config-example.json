{
  "_comment": "Add these entries to your ~/.claude/hooks.json to enable NotebookLM Studio hooks",
  "_instructions": "Merge the PreToolUse and PostToolUse arrays into your existing hooks.json. Update the paths to match your hook script locations.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__notebooklm-mcp__studio_create|mcp__notebooklm-mcp__notebook_delete|mcp__notebooklm-mcp__source_delete|mcp__notebooklm-mcp__studio_delete",
        "hooks": [
          {
            "type": "command",
            "command": "node <PATH_TO_HOOKS>/confirm-guard.js",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "mcp__notebooklm-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node <PATH_TO_HOOKS>/auth-health-check.js",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "mcp__notebooklm-mcp__download_artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node <PATH_TO_HOOKS>/download-path-enforcer.js",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__notebooklm-mcp__studio_create",
        "hooks": [
          {
            "type": "command",
            "command": "node <PATH_TO_HOOKS>/chain-enforcer.js",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
